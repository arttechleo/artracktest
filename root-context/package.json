{
  "name": "root-theater",
  "private": true,
  "workspaces": [
    "shared/protocol",
    "apps/relay-server",
    "apps/audience-ar"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:relay\" \"npm run dev:ar\"",
    "dev:relay": "npm run dev -w apps/relay-server",
    "dev:ar": "npm run dev -w apps/audience-ar",
    "build": "npm run build -w shared/protocol && npm run build -w apps/relay-server && npm run build -w apps/audience-ar"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "~5.9.3"
  }
}
